#!/usr/bin/env bash
#MISE description="Run plugin tests - install and execute tool"
set -euo pipefail

mise plugin link --force fastflowlm .
mise cache clear
mise install fastflowlm@latest

# Capture and display the output while also verifying it
output=$(mise exec "fastflowlm@latest" -- "fastflowlm" --version)
echo "fastflowlm output: $output"

if echo "$output" | grep -qi 'fastflowlm'; then
    echo "✓ Tests passed"
else
    echo "✗ Test failed: unexpected output"
    exit 1
fi