#!/usr/bin/env bash
#MISE description="Run plugin tests - install and execute tool"
set -euo pipefail

mise plugin link --force fastflowlm .[cite: 5]
mise cache clear[cite: 5]
mise install fastflowlm@latest[cite: 5]

# Test executing via flm
output=$(mise exec "fastflowlm@latest" -- flm --help 2>&1 || mise exec "fastflowlm@latest" -- flm --version 2>&1)
echo "flm output: $output"

# Test executing via the alias fastflowlm
output_alias=$(mise exec "fastflowlm@latest" -- fastflowlm --help 2>&1 || mise exec "fastflowlm@latest" -- fastflowlm --version 2>&1)
echo "fastflowlm output: $output_alias"

if echo "$output" | grep -qiE 'fastflow|flm|usage'; then
    echo "✓ Tests passed"[cite: 5]
else
    echo "✗ Test failed: unexpected output"[cite: 5]
    exit 1[cite: 5]
fi