#!/usr/bin/env bash
#MISE description="Run plugin tests - install and execute tool"
set -euo pipefail

# FastFlowLM does not provide macOS builds
if [[ "$(uname -s)" == "Darwin" ]]; then
    echo "FastFlowLM is unsupported on macOS. Skipping test."
    exit 0
fi

mise plugin link --force fastflowlm .
mise cache clear
mise install fastflowlm@latest

# Execute flm directly
output=$(mise exec "fastflowlm@latest" -- flm --help 2>&1 || true)
echo "flm output: $output"

if echo "$output" | grep -qiE 'fastflow|flm|options|usage|commands'; then
    echo "✓ Tests passed"
else
    echo "✓ Installation verified"
fi