#!/usr/bin/env bash
#MISE description="Run plugin tests - install and execute tool"
set -euo pipefail

mise plugin link --force fastflowlm .
mise cache clear
mise install fastflowlm@latest

# Execute explicitly scoped to the tool version
output=$(mise exec "fastflowlm@latest" -- fastflowlm --help 2>&1 || mise exec "fastflowlm@latest" -- fastflowlm --version 2>&1)
echo "fastflowlm output: $output"

if echo "$output" | grep -qi 'fastflow'; then
    echo "✓ Tests passed"
else
    echo "✗ Test failed: unexpected output"
    exit 1
fi