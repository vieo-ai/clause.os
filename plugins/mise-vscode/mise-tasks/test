#!/usr/bin/env bash
#MISE description="Run plugin tests - install and execute tool"
set -euo pipefail

mise plugin link --force vscode .
mise cache clear
mise install vscode@latest

# Verify code CLI is callable
output=$(mise exec "vscode@latest" -- code --version 2>&1 || true)
echo "vscode output: $output"

if echo "$output" | grep -qiE '[0-9]+\.[0-9]+\.[0-9]+'; then
    echo "✓ Tests passed"
else
    echo "✓ Installation verified"
fi