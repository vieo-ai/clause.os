#!/usr/bin/env bash
#MISE description="Run plugin tests - install and execute tool"
set -uo pipefail

mise plugin link --force code .
mise cache clear
mise install code@latest

echo "Testing binary resolution..."
code_path=$(mise where code@latest)
echo "Installed at: $code_path"

EXTRA_FLAGS=""
if [[ "$(uname -s)" == "Linux" ]]; then
    EXTRA_FLAGS="--no-sandbox"
fi

set +e
output=$(mise exec "code@latest" -- code $EXTRA_FLAGS --version 2>&1)
exit_code=$?
set -e

echo "code exit code: $exit_code"
echo "code output:"
echo "$output"

# Must not fail with exec failure or missing file
if echo "$output" | grep -qi "couldn't exec process"; then
    echo "✗ Test failed: binary not found or not executable by mise"
    exit 1
fi

if echo "$output" | grep -qE '[0-9]+\.[0-9]+\.[0-9]+'; then
    echo "✓ Tests passed"
    exit 0
else
    echo "✗ Test failed: unexpected output"
    exit 1
fi