#!/usr/bin/env bash
#MISE description="Run plugin tests - install and execute tool"
set -euo pipefail

mise plugin link --force vscode .
mise cache clear
mise install vscode@latest

# Verify code CLI runs successfully and captures a valid version response
set +e
output=$(mise exec "vscode@latest" -- code --version 2>&1)
exit_code=$?
set -e

echo "vscode output:"
echo "$output"

if [ $exit_code -eq 0 ] && echo "$output" | grep -qE '^[0-9]+\.[0-9]+\.[0-9]+'; then
    echo "✓ Tests passed"
else
    echo "✗ Test failed: command returned exit code $exit_code"
    exit 1
fi