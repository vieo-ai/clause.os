#!/usr/bin/env bash
#MISE description="Run plugin tests - install and execute tool"
set -euo pipefail

mise plugin link --force code .
mise cache clear
mise install code@latest

output=$(mise exec "code@latest" -- code --version 2>&1)
echo "code output:"
echo "$output"

if echo "$output" | grep -qE '[0-9]+\.[0-9]+\.[0-9]+'; then
    echo "✓ Tests passed"
else
    echo "✗ Test failed: unexpected version output"
    exit 1
fi