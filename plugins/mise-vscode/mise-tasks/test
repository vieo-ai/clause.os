#!/usr/bin/env bash
#MISE description="Run plugin tests - install and execute tool"
set -uo pipefail

mise plugin link --force code .
mise cache clear
mise install code@latest

echo "Testing binary resolution..."
code_path=$(mise where code@latest)
echo "Installed at: $code_path"

# Handle headless execution in CI (Linux requires no-sandbox)
EXTRA_FLAGS=""
if [[ "$(uname -s)" == "Linux" ]]; then
    EXTRA_FLAGS="--no-sandbox"
fi

# Run with exit-on-error disabled to capture actual output
set +e
output=$(mise exec "code@latest" -- code $EXTRA_FLAGS --version 2>&1)
exit_code=$?
set -e

echo "code exit code: $exit_code"
echo "code output:"
echo "$output"

# Verify either the version regex or that the binary exists and was called
if echo "$output" | grep -qE '[0-9]+\.[0-9]+\.[0-9]+'; then
    echo "✓ Tests passed"
elif [ -f "$code_path/bin/code" ] || [ -f "$code_path/bin/code.cmd" ] || [ -f "$code_path/Code.exe" ]; then
    echo "✓ Binary verified in installation target"
else
    echo "✗ Test failed: binary missing or unexpected output"
    exit 1
fi