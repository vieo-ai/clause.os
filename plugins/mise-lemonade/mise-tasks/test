#!/usr/bin/env bash
#MISE description="Run plugin tests - install and execute tool"
set -euo pipefail

mise plugin link --force lemonade .
mise cache clear
mise install lemonade@latest

# Capture and display the output while also verifying it
output=$(mise exec "lemonade@latest" -- "lemonade" --version)
echo "lemonade output: $output"

if echo "$output" | grep -qi 'lemonade'; then
    echo "✓ Tests passed"
else
    echo "✗ Test failed: unexpected output"
    exit 1
fi