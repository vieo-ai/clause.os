#!/usr/bin/env bash
set -euo pipefail

echo "[test] Linking local comfyui plugin..."
mise plugins link --force comfyui .
mise cache clear

echo "[test] Ensuring prerequisite uv is installed..."
mise use -g uv@latest || mise install uv@latest

echo "[test] Installing comfyui@latest..."
mise install comfyui@latest

echo "[test] Verifying ComfyUI installation and CLI shims..."
mise exec comfyui@latest -- comfyui --help || true

echo "[test] Verified ComfyUI successfully provisioned."