# ==============================================================================
# CARRIER / CLAUSE OS - HERMETIC ENVIRONMENT CONFIGURATION
# SINGLE SOURCE OF TRUTH (SSOT) FOR WORKSPACE ANCHORS & PATHS
# ==============================================================================

############
# [optional]
# 1. RUNTIME LOGGING & DIAGNOSTICS
# Set to empty to disable (default: empty) 
# Options (trace | debug | info | warn | error)
############
USER_LOG_LEVEL=""
MISE_LOG_FILE_LEVEL=""

############
# [restricted]
# 2. HERMETIC BASE ANCHORS
# Root confinement directory relative to project root
# WARNING: Changing these breaks sandboxing invariants
############
CLAUSE_HOME=".home"
HOME=".home"
USERPROFILE=".home"

############
# [restricted]
# 3. IDENTITY, GIT & SSH CONFINEMENT
# Isolates developer identity and credentials strictly to the hermetic tree
# Prevents unintentional reads from machine-global ~/.gitconfig or ~/.ssh
# WARNING: Changing these breaks sandboxing invariants
############
GIT_CONFIG_GLOBAL=".home/.gitconfig"
PULUMI_HOME=".home/.pulumi"

############
# [restricted]
# 4. CLI & RUNTIME CONFIGURATION ROOTS
# Internal search and config anchors for the Nushell control plane
# WARNING: Changing these breaks sandboxing invariants
############
NU_CONFIG_DIR="scripts/cli/nu/config"

############
# [restricted]
# 5. POSIX / XDG DIRECTORY STANDARDS
# Enforces Linux/macOS standard paths isolated inside project-relative storage
# Maps XDG standards into the .home isolation directory
# WARNING: Changing these breaks sandboxing invariants
############
XDG_CONFIG_HOME=".home/.config"
XDG_DATA_HOME=".home/.local/share"
XDG_STATE_HOME=".home/.local/state"
XDG_CACHE_HOME=".home/.cache"

POSIX_CLAUSE_BIN_DIR=".home/.local/bin"
POSIX_CLAUSE_APPS_DIR=".home/.local/apps"
POSIX_CLAUSE_LOGS_DIR=".home/.local/logs"

############
# [restricted]
# 6. WINDOWS NT PLATFORM HIERARCHY
# Native Windows NT Known Folder architecture pinned inside .home
# Guarantees AppData isolation so Local, Roaming, and Cache remain hermetic
# WARNING: Changing these breaks sandboxing invariants
############
WIN_LOCALAPPDATA=".home/AppData/Local"
WIN_APPDATA=".home/AppData/Roaming"
WIN_CLAUSE_BIN_DIR=".home/AppData/Local/Programs/bin"
WIN_CLAUSE_APPS_DIR=".home/AppData/Local/Programs/apps"
WIN_CLAUSE_LOGS_DIR=".home/AppData/Local/Programs/logs"
WIN_CLAUSE_TEMP_DIR=".home/AppData/Local/Temp"
WIN_CLAUSE_CACHE_DIR=".home/AppData/Local/cache"

############
# [restricted]
# 7. WINDOWS NT HOME & SCRATCH CONFINEMENT
# Overrides host system user temp and home drive targets
# Confines tilde (~) expansion and child process scratch storage to .home
# Options (Empty string dynamic resolution | Static drive/path override)
# WARNING: Changing these breaks sandboxing invariants
############
WIN_TEMP=".home/AppData/Local/Temp"
WIN_TMP=".home/AppData/Local/Temp"
WIN_HOMEDRIVE=""
WIN_HOMEPATH=""

############
# [restricted]
# 8. HERMETIC DROP-IN INSTALLERS ROOT
# Directory scanned for drop-in tool/dependency install scripts
# Scripts matching install_*.ps1 or install_*.sh are executed sequentially
# WARNING: Changing these breaks sandboxing invariants
############
POSIX_INSTALLERS_DIR="scripts/cli/posix/installers"
WIN_INSTALLERS_DIR="scripts/cli/pwsh/installers"

############
# [restricted]
# 9. MISE ORCHESTRATION & HERMETIC BACKENDS
# Enforces hermetic storage boundaries for Mise data, cache, state, and config
# Platform-specific prefixes (POSIX_ / WIN_) are mapped dynamically by cx.sh and cx.ps1
# WARNING: Changing these breaks sandboxing invariants
############
POSIX_MISE_DATA_DIR=.home/.local/share/mise
POSIX_MISE_CACHE_DIR=.home/.cache/mise
POSIX_MISE_STATE_DIR=.home/.local/state/mise
POSIX_MISE_CONFIG_DIR=.home/.config/mise

WIN_MISE_DATA_DIR=.home/AppData/Local/mise
WIN_MISE_CACHE_DIR=.home/AppData/Local/cache/mise
WIN_MISE_STATE_DIR=.home/AppData/Local/state/mise
WIN_MISE_CONFIG_DIR=.home/AppData/Local/config/mise

MISE_SYSTEM_BREW_PREFIX=.home/.cache/toolchain/brew
MISE_YES=1
MISE_NOT_FOUND_AUTO_INSTALL=0
MISE_EXPERIMENTAL=1

############
# [restricted]
# 10. SCOOP PACKAGE MANAGER ISOLATION (WINDOWS)
# Confines Scoop user and global directories strictly inside .home
# Prevents registry PATH leaks and Start Menu pollution on Windows hosts
# WARNING: Changing these breaks sandboxing invariants
############
SCOOP=.home/AppData/Local/cache/toolchain/scoop
SCOOP_GLOBAL=.home/AppData/Local/cache/toolchain/scoop_global

############
# [restricted]
# 11. HOMEBREW ISOLATION (POSIX: MACOS, LINUX, WSL)
# Confines Homebrew prefix, cellar, cache, and logs strictly inside .home
# Prevents leaks to /opt/homebrew or /home/linuxbrew and disables analytics/auto-updates
# WARNING: Changing these breaks sandboxing invariants
############
HOMEBREW_PREFIX=.home/.cache/toolchain/brew
HOMEBREW_CELLAR=.home/.cache/toolchain/brew/Cellar
HOMEBREW_REPOSITORY=.home/.cache/toolchain/brew
HOMEBREW_CACHE=.home/.cache/homebrew
HOMEBREW_LOGS=.home/.local/state/homebrew/logs
HOMEBREW_TEMP=.home/.cache/tmp/homebrew

HOMEBREW_NO_AUTO_UPDATE=1
HOMEBREW_NO_ANALYTICS=1
HOMEBREW_NO_ENV_HINTS=1

############
# [restricted]
# 12. HUGGING FACE HUB & RUNTIME ISOLATION
# Disables telemetry, enforces deterministic cache behavior, and enables fast transfers
# Platform-specific prefixes (POSIX_ / WIN_) are mapped dynamically by cx.sh and cx.ps1
# WARNING: Changing these breaks sandboxing invariants
############
POSIX_HF_HOME=.home/.cache/huggingface
POSIX_HF_HUB_CACHE=.home/.cache/huggingface/hub
POSIX_HF_ASSETS_CACHE=.home/.cache/huggingface/assets

WIN_HF_HOME=.home/AppData/Local/cache/huggingface
WIN_HF_HUB_CACHE=.home/AppData/Local/cache/huggingface/hub
WIN_HF_ASSETS_CACHE=.home/AppData/Local/cache/huggingface/assets

HF_HUB_DISABLE_TELEMETRY=1
HF_HUB_ENABLE_HF_TRANSFER=1
HF_HUB_DISABLE_PROGRESS_BARS=0
DO_NOT_TRACK=1

############
# [restricted]
# 13. NUSHELL RUNTIME & CONFIGURATION ISOLATION
# Confines Nushell config, command history, plugin registry, and library paths inside .home
# Prevents host pollution in ~/.config/nushell and %APPDATA%\nushell
# WARNING: Changing these breaks sandboxing invariants
############
POSIX_NU_CONFIG_DIR=.home/.config/nushell
POSIX_NU_LIB_DIRS=.home/.config/nushell/scripts
POSIX_NU_PLUGIN_DIRS=.home/.local/share/nushell/plugins

WIN_NU_CONFIG_DIR=.home/AppData/Local/config/nushell
WIN_NU_LIB_DIRS=.home/AppData/Local/config/nushell/scripts
WIN_NU_PLUGIN_DIRS=.home/AppData/Local/nushell/plugins

NU_LOG_LEVEL=warn